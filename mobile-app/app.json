{
  "expo": {
    "name": "Nivo Support",
    "slug": "nivo-support",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1337ec"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.nivosupport",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1337ec"
      },
      "package": "com.yourcompany.nivosupport",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "environment": "development",
      "apiUrls": {
        "development": "http://10.0.2.2:5016",
        "staging": "https://enrichbeauty.solutionsnextwave.com/api",
        "production": "https://support.yourcompany.com/api"
      },
      "eas": {
        "projectId": "a20ffd82-abd9-495a-b145-8217216b08e6"
      }
    },
    "owner": "gogulan_2003"
  }
}
