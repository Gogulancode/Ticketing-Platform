{
  "expo": {
    "name": "Nivo Support",
    "slug": "nivo-support",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1337ec"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nivosupport.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "This app uses the camera to capture photos for ticket attachments.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to attach images to support tickets.",
        "NSPhotoLibraryAddUsageDescription": "This app saves downloaded attachments to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1337ec"
      },
      "package": "com.nivosupport.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for ticket attachments.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for ticket attachments."
        }
      ]
    ],
    "extra": {
      "environment": "development",
      "apiUrls": {
        "development": "http://10.0.2.2:5016",
        "staging": "https://enrichbeauty.solutionsnextwave.com/api",
        "production": "https://support.yourcompany.com/api"
      },
      "eas": {
        "projectId": "a20ffd82-abd9-495a-b145-8217216b08e6"
      }
    },
    "owner": "gogulan_2003"
  }
}
