# Production environment configuration
# This file is used when NODE_ENV=production

# Production Environment Variables
# These are used when building for production (npm run build)

# API Base URL - Set to production domain (prefer HTTPS)
VITE_API_BASE_URL=https://businesshub.babajishivram.com:449/api

# API port overrides for dynamic detection
VITE_API_HTTP_PORT=81
VITE_API_HTTPS_PORT=449

# Node environment
NODE_ENV=production

# Use mock data fallbacks when API endpoints fail (false for production)
VITE_USE_MOCKS=false

# Enable Training Module access (false for ticketing-only production)
VITE_ENABLE_TRAINING_MODULE=false