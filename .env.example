# Frontend environment configuration
# Copy this file to .env.local (Vite will load .env*, prioritize .env.local)

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5015/api

# Use mock data fallbacks when API endpoints fail (true/false)
VITE_USE_MOCKS=false

# Enable Training Module access (true for development, false for staging/production)
# This controls visibility of "Switch to Training" button and Training option on landing page
VITE_ENABLE_TRAINING_MODULE=true
