import React, { useState, useEffect } from 'react';
import {
  Tag, Building, AlertCircle, CheckCircle, Users,
  User, Mail, Brain, Edit, Trash2, Plus
} from 'lucide-react';
import toast from 'react-hot-toast';
import {
  settingsApi,
  Department,
  TicketCategoryConfig,
  PriorityLevel,
  TicketStatusConfig,
  CategoryEmailMapping
} from '../../../shared/services/api/settingsApi';
import { SimplifiedAutoAssignment } from '../components/SimplifiedAutoAssignment';
import { EmailMappingModal } from '../components/EmailMappingModal';

// -------------------- Types --------------------
interface TicketGroup {
  id: number;
  name: string;
  description?: string;
  isActive: boolean;
}

interface Agent {
  id: number;
  userId: string;
  name: string;
  email: string;
  departmentId?: number;
  departmentName?: string;
  agentGroupId?: number;
  agentGroupName?: string;
  isActive: boolean;
  maxTicketsCapacity: number;
  currentTicketCount: number;
  availabilityStatus: string;
  createdAt: string;
  updatedAt: string;
  groups?: TicketGroup[];
}

type ModalType = 'category' | 'department' | 'priority' | 'status' | 'group' | 'agent';

// -------------------- Mock Data --------------------
const mockCategories: TicketCategoryConfig[] = [
  { id: 1, name: 'Hardware Issue', description: 'Computer hardware problems', isActive: true, order: 1, subCategories: [] },
  { id: 2, name: 'Software Issue', description: 'Software installation and configuration', isActive: true, order: 2, subCategories: [] },
  { id: 3, name: 'Network Issue', description: 'Network connectivity problems', isActive: true, order: 3, subCategories: [] }
];

const mockDepartments: Department[] = [
  { id: 1, name: 'IT Support', description: 'Information Technology Support', isActive: true, order: 1 },
  { id: 2, name: 'Human Resources', description: 'HR related issues', isActive: true, order: 2 },
  { id: 3, name: 'Finance', description: 'Financial and accounting', isActive: true, order: 3 }
];

const mockPriorities: PriorityLevel[] = [
  { id: 1, name: 'Low', level: 1, color: '#10B981', isActive: true, order: 1 },
  { id: 2, name: 'Medium', level: 2, color: '#F59E0B', isActive: true, order: 2 },
  { id: 3, name: 'High', level: 3, color: '#EF4444', isActive: true, order: 3 },
  { id: 4, name: 'Critical', level: 4, color: '#DC2626', isActive: true, order: 4 }
];

const mockStatuses: TicketStatusConfig[] = [
  { id: 1, name: 'Open', workflowOrder: 1, isActive: true, color: '#3B82F6', allowedTransitions: [2, 4] },
  { id: 2, name: 'In Progress', workflowOrder: 2, isActive: true, color: '#F59E0B', allowedTransitions: [3, 4] },
  { id: 3, name: 'Resolved', workflowOrder: 3, isActive: true, color: '#10B981', allowedTransitions: [4] },
  { id: 4, name: 'Closed', workflowOrder: 4, isActive: true, color: '#6B7280', allowedTransitions: [] }
];

const mockGroups: TicketGroup[] = [
  { id: 1, name: 'Level 1 Support', description: 'First level support team', isActive: true },
  { id: 2, name: 'Level 2 Support', description: 'Second level support team', isActive: true },
  { id: 3, name: 'Specialists', description: 'Specialized support team', isActive: true }
];

const mockAgents: Agent[] = [
  { id: 1, userId: 'user1', name: 'John Doe', email: 'john@company.com', departmentId: 1, departmentName: 'IT Support', isActive: true, maxTicketsCapacity: 10, currentTicketCount: 3, availabilityStatus: 'Available', createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() },
  { id: 2, userId: 'user2', name: 'Jane Smith', email: 'jane@company.com', departmentId: 1, departmentName: 'IT Support', isActive: true, maxTicketsCapacity: 15, currentTicketCount: 7, availabilityStatus: 'Busy', createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() }
];

// -------------------- Component --------------------
const TicketSettingsPage: React.FC = () => {
  const [activeTab, setActiveTab] = useState('categories');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [usingMockData, setUsingMockData] = useState(false);

  // Entity states
  const [categories, setCategories] = useState<TicketCategoryConfig[]>([]);
  const [departments, setDepartments] = useState<Department[]>([]);
  const [priorities, setPriorities] = useState<PriorityLevel[]>([]);
  const [statuses, setStatuses] = useState<TicketStatusConfig[]>([]);
  const [groups, setGroups] = useState<TicketGroup[]>([]);
  const [agents, setAgents] = useState<Agent[]>([]);
  const [emailMappings, setEmailMappings] = useState<CategoryEmailMapping[]>([]);

  // Modal states
  const [showEmailModal, setShowEmailModal] = useState(false);
  const [editingMapping, setEditingMapping] = useState<CategoryEmailMapping | null>(null);

  const [showSettingsModal, setShowSettingsModal] = useState(false);
  const [modalType, setModalType] = useState<ModalType | ''>('');
  const [editingItem, setEditingItem] = useState<any>(null);
  const [modalData, setModalData] = useState<any>({});

  // -------------------- Handlers --------------------
  const handleAdd = (type: ModalType) => {
    setModalType(type);
    setEditingItem(null);
    setModalData({});
    setShowSettingsModal(true);
  };

  // -------------------- Load Data --------------------
  const loadData = async () => {
    try {
      setLoading(true);
      setError('');

      switch (activeTab) {
        case 'categories':
          try {
            console.log('🔍 Fetching categories from API...');
            const data = await settingsApi.getTicketCategories();
            console.log('✅ Categories fetched successfully:', data);
            setCategories(data);
            setUsingMockData(false);
          } catch (error) {
            console.error('❌ Categories API failed:', error);
            setCategories(mockCategories);
            setUsingMockData(true);
            toast.error(`Categories API failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
          }
          break;

        case 'departments':
          try {
            console.log('🔍 Fetching departments from API...');
            const data = await settingsApi.getDepartments();
            console.log('✅ Departments fetched successfully:', data);
            setDepartments(data);
            setUsingMockData(false);
          } catch (error) {
            console.error('❌ Departments API failed:', error);
            setDepartments(mockDepartments);
            setUsingMockData(true);
            toast.error(`Departments API failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
          }
          break;

        case 'priorities':
          try {
            const data = await settingsApi.getPriorityLevels();
            setPriorities(data);
            setUsingMockData(false);
          } catch {
            setPriorities(mockPriorities);
            setUsingMockData(true);
          }
          break;

        case 'statuses':
          try {
            const data = await settingsApi.getTicketStatuses();
            setStatuses(data);
            setUsingMockData(false);
          } catch {
            setStatuses(mockStatuses);
            setUsingMockData(true);
          }
          break;

        case 'groups':
          try {
            const data = await settingsApi.getTicketGroups();
            setGroups(data);
            setUsingMockData(false);
          } catch {
            setGroups(mockGroups);
            setUsingMockData(true);
          }
          break;

        case 'agents':
          try {
            const data = await settingsApi.getAgents();
            setAgents(data);
            setUsingMockData(false);
          } catch {
            setAgents(mockAgents);
            setUsingMockData(true);
          }
          break;

        case 'email':
          try {
            const data = await settingsApi.getCategoryEmailMappings();
            setEmailMappings(data);
            setUsingMockData(false);
          } catch {
            setEmailMappings([]);
            setUsingMockData(true);
          }
          break;

        default:
          break;
      }
    } catch (err) {
      console.error('Error loading data:', err);
      setError('Failed to load data. Using mock data.');
      setUsingMockData(true);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, [activeTab]);

  // -------------------- CRUD --------------------
  const handleEdit = (item: any, type: ModalType) => {
    setModalType(type);
    setEditingItem(item);
    setModalData({ ...item });
    setShowSettingsModal(true);
  };

  const handleDelete = async (id: number, type: ModalType) => {
    if (!confirm(`Are you sure you want to delete this ${type}?`)) return;

    try {
      switch (type) {
        case 'category':
          await settingsApi.deleteCategory(id);
          setCategories(categories.filter(c => c.id !== id));
          break;
        // ... (repeat for others)
      }
      toast.success(`${type} deleted successfully`);
    } catch (err) {
      setError(`Failed to delete ${type}`);
      console.error(err);
      toast.error(`Failed to delete ${type}`);
    }
  };

  const handleModalSave = async () => {
    try {
      setLoading(true);
      
      if (modalType === 'category') {
        if (editingItem) {
          // Update existing category
          const updated = await settingsApi.updateCategory(editingItem.id, modalData);
          setCategories(categories.map(c => c.id === editingItem.id ? updated : c));
        } else {
          // Create new category
          const newCategory = await settingsApi.createCategory(modalData);
          setCategories([...categories, newCategory]);
        }
      } else if (modalType === 'department') {
        if (editingItem) {
          const updated = await settingsApi.updateDepartment(editingItem.id, modalData);
          setDepartments(departments.map(d => d.id === editingItem.id ? updated : d));
        } else {
          const newDepartment = await settingsApi.createDepartment(modalData);
          setDepartments([...departments, newDepartment]);
        }
      }
      // Add other modal types as needed...
      
      toast.success(
        `${modalType?.charAt(0).toUpperCase() + modalType?.slice(1)} ${editingItem ? 'updated' : 'created'} successfully`
      );
      setShowSettingsModal(false);
      setEditingItem(null);
      setModalData({});
    } catch (err) {
      console.error('Modal save error:', err);
      toast.error(`Failed to ${editingItem ? 'update' : 'create'} ${modalType}. Please try again.`);
    } finally {
      setLoading(false);
    }
  };

  // -------------------- Email Mapping --------------------
  const handleAddEmailMapping = () => {
    setEditingMapping(null);
    setShowEmailModal(true);
  };

  const handleEditEmailMapping = (mapping: CategoryEmailMapping) => {
    setEditingMapping(mapping);
    setShowEmailModal(true);
  };

  const handleDeleteEmailMapping = async (id: number) => {
    if (!confirm('Are you sure you want to delete this email mapping?')) return;

    try {
      await settingsApi.deleteEmailMappingById(id);
      loadData();
      toast.success('Email mapping deleted successfully');
    } catch (err) {
      console.error(err);
      setEmailMappings(emailMappings.filter(m => m.id !== id));
      toast.success('Email mapping deleted locally (API unavailable)');
    }
  };

  // -------------------- Render --------------------
  const renderContent = () => {
    if (loading) return <div className="flex items-center justify-center h-64">Loading...</div>;
    if (error) return <div className="text-red-600">{error}</div>;

    switch (activeTab) {
      case 'auto-assignment':
        return <SimplifiedAutoAssignment />;

      case 'categories':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Ticket Categories</h3>
              <div className="flex gap-2">
                <button
                  onClick={async () => {
                    try {
                      console.log('🧪 Direct API test starting...');
                      const response = await fetch('http://localhost:5015/api/tickets/settings/categories', {
                        method: 'GET',
                        headers: {
                          'Content-Type': 'application/json',
                        }
                      });
                      console.log('🧪 Response status:', response.status);
                      console.log('🧪 Response headers:', response.headers);
                      const data = await response.json();
                      console.log('🧪 Raw response data:', data);
                      alert(`Success! Got ${data.value?.length || data.length || 0} categories`);
                    } catch (error) {
                      console.error('🧪 Direct test failed:', error);
                      alert(`Direct API test failed: ${error.message}`);
                    }
                  }}
                  className="px-3 py-1 bg-yellow-600 text-white rounded text-sm hover:bg-yellow-700"
                >
                  🧪 Test API
                </button>
                <button
                  onClick={() => handleAdd('category')}
                  className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
                >
                  <Plus className="h-4 w-4" aria-label="Add category" />
                  <span>Add Category</span>
                </button>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {categories.map((category) => (
                <div key={category.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <h4 className="font-semibold text-gray-900">{category.name}</h4>
                      {category.description && (
                        <p className="text-sm text-gray-600 mt-1">{category.description}</p>
                      )}
                    </div>
                    <div className="flex space-x-2">
                      <button
                        onClick={() => handleEdit(category, 'category')}
                        className="text-blue-600 hover:text-blue-800"
                      >
                        <Edit className="h-4 w-4" />
                      </button>
                      <button
                        onClick={() => handleDelete(category.id, 'category')}
                        className="text-red-600 hover:text-red-800"
                      >
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'departments':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Departments</h3>
              <button
                onClick={() => handleAdd('department')}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Department</span>
              </button>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {departments.map((dept) => (
                <div key={dept.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <h4 className="font-semibold text-gray-900">{dept.name}</h4>
                      {dept.description && <p className="text-gray-600 text-sm mt-1">{dept.description}</p>}
                      <span className={`inline-block px-2 py-1 rounded-full text-xs mt-2 ${
                        dept.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                      }`}>
                        {dept.isActive ? 'Active' : 'Inactive'}
                      </span>
                    </div>
                    <div className="flex space-x-2">
                      <button onClick={() => handleEdit(dept, 'department')} className="text-blue-600 hover:text-blue-800">
                        <Edit className="h-4 w-4" />
                      </button>
                      <button onClick={() => handleDelete(dept.id, 'department')} className="text-red-600 hover:text-red-800">
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'priorities':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Priority Levels</h3>
              <button
                onClick={() => handleAdd('priority')}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Priority</span>
              </button>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {priorities.map((priority) => (
                <div key={priority.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <div className="flex items-center space-x-2">
                        <div className="w-3 h-3 rounded-full" style={{ backgroundColor: priority.color }}></div>
                        <h4 className="font-semibold text-gray-900">{priority.name}</h4>
                      </div>
                      <p className="text-gray-600 text-sm mt-1">Level {priority.level}</p>
                      <span className={`inline-block px-2 py-1 rounded-full text-xs mt-2 ${
                        priority.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                      }`}>
                        {priority.isActive ? 'Active' : 'Inactive'}
                      </span>
                    </div>
                    <div className="flex space-x-2">
                      <button onClick={() => handleEdit(priority, 'priority')} className="text-blue-600 hover:text-blue-800">
                        <Edit className="h-4 w-4" />
                      </button>
                      <button onClick={() => handleDelete(priority.id, 'priority')} className="text-red-600 hover:text-red-800">
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'statuses':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Ticket Statuses</h3>
              <button
                onClick={() => handleAdd('status')}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Status</span>
              </button>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {statuses.map((status) => (
                <div key={status.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <div className="flex items-center space-x-2">
                        <div className="w-3 h-3 rounded-full" style={{ backgroundColor: status.color }}></div>
                        <h4 className="font-semibold text-gray-900">{status.name}</h4>
                      </div>
                      <p className="text-gray-600 text-sm mt-1">Order: {status.workflowOrder}</p>
                      <span className={`inline-block px-2 py-1 rounded-full text-xs mt-2 ${
                        status.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                      }`}>
                        {status.isActive ? 'Active' : 'Inactive'}
                      </span>
                    </div>
                    <div className="flex space-x-2">
                      <button onClick={() => handleEdit(status, 'status')} className="text-blue-600 hover:text-blue-800">
                        <Edit className="h-4 w-4" />
                      </button>
                      <button onClick={() => handleDelete(status.id, 'status')} className="text-red-600 hover:text-red-800">
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'groups':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Ticket Groups</h3>
              <button
                onClick={() => handleAdd('group')}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Group</span>
              </button>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {groups.map((group) => (
                <div key={group.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <h4 className="font-semibold text-gray-900">{group.name}</h4>
                      {group.description && <p className="text-gray-600 text-sm mt-1">{group.description}</p>}
                      <span className={`inline-block px-2 py-1 rounded-full text-xs mt-2 ${
                        group.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                      }`}>
                        {group.isActive ? 'Active' : 'Inactive'}
                      </span>
                    </div>
                    <div className="flex space-x-2">
                      <button onClick={() => handleEdit(group, 'group')} className="text-blue-600 hover:text-blue-800">
                        <Edit className="h-4 w-4" />
                      </button>
                      <button onClick={() => handleDelete(group.id, 'group')} className="text-red-600 hover:text-red-800">
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'agents':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Support Agents</h3>
              <button
                onClick={() => handleAdd('agent')}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Agent</span>
              </button>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {agents.map((agent) => (
                <div key={agent.id} className="border rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div className="flex justify-between items-start">
                    <div>
                      <h4 className="font-semibold text-gray-900">{agent.name}</h4>
                      <p className="text-gray-600 text-sm">{agent.email}</p>
                      {agent.departmentName && <p className="text-gray-600 text-sm">{agent.departmentName}</p>}
                      <div className="mt-2">
                        <span className={`inline-block px-2 py-1 rounded-full text-xs mr-2 ${
                          agent.availabilityStatus === 'Available' ? 'bg-green-100 text-green-800' : 
                          agent.availabilityStatus === 'Busy' ? 'bg-yellow-100 text-yellow-800' :
                          'bg-red-100 text-red-800'
                        }`}>
                          {agent.availabilityStatus}
                        </span>
                        <span className="text-xs text-gray-600">
                          {agent.currentTicketCount}/{agent.maxTicketsCapacity} tickets
                        </span>
                      </div>
                    </div>
                    <div className="flex space-x-2">
                      <button onClick={() => handleEdit(agent, 'agent')} className="text-blue-600 hover:text-blue-800">
                        <Edit className="h-4 w-4" />
                      </button>
                      <button onClick={() => handleDelete(agent.id, 'agent')} className="text-red-600 hover:text-red-800">
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      case 'email':
        return (
          <div className="space-y-sm text-sm leading-snug">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-semibold leading-tight">Email Configuration</h3>
              <button
                onClick={handleAddEmailMapping}
                className="flex items-center space-x-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                <Plus className="h-4 w-4" />
                <span>Add Email Mapping</span>
              </button>
            </div>
            <div className="bg-white border rounded-lg overflow-hidden">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {emailMappings.map((mapping) => (
                    <tr key={mapping.id}>
                      <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                        {mapping.categoryName}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {mapping.emailAddress}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <button
                          onClick={() => handleEditEmailMapping(mapping)}
                          className="text-blue-600 hover:text-blue-900 mr-3"
                        >
                          <Edit className="h-4 w-4" />
                        </button>
                        <button
                          onClick={() => handleDeleteEmailMapping(mapping.id)}
                          className="text-red-600 hover:text-red-900"
                        >
                          <Trash2 className="h-4 w-4" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );

      default:
        return <div>Please select a tab to view content.</div>;
    }
  };

  return (
    <div className="p-6 text-sm leading-snug">
      <div className="mb-6">
        <h1 className="text-2xl font-bold text-gray-900 mb-sm leading-tight">Ticket Settings</h1>
        <p className="text-gray-600">Configure ticket system settings and parameters</p>
      </div>

      {/* Tabs */}
      <div className="mb-6">
        <nav className="flex space-x-8 border-b border-gray-200">
          {[
            { id: 'categories', label: 'Categories', icon: Tag },
            { id: 'departments', label: 'Departments', icon: Building },
            { id: 'priorities', label: 'Priorities', icon: AlertCircle },
            { id: 'statuses', label: 'Statuses', icon: CheckCircle },
            { id: 'groups', label: 'Groups', icon: Users },
            { id: 'agents', label: 'Agents', icon: User },
            { id: 'email', label: 'Email Config', icon: Mail },
            { id: 'auto-assignment', label: 'Auto Assignment', icon: Brain }
          ].map((tab) => {
            const Icon = tab.icon;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center space-x-2 py-2 px-1 border-b-2 font-medium text-sm ${
                  activeTab === tab.id
                    ? 'border-blue-500 text-blue-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                }`}
              >
                <Icon className="h-4 w-4" />
                <span>{tab.label}</span>
              </button>
            );
          })}
        </nav>
      </div>

      <div className="bg-white rounded-lg shadow p-6">{renderContent()}</div>

      {/* Email Modal */}
      <EmailMappingModal
        isOpen={showEmailModal}
        onClose={() => setShowEmailModal(false)}
        mapping={editingMapping}
        categories={categories}
        onSaved={() => {
          setShowEmailModal(false);
          loadData();
        }}
      />

      {/* Settings Modal */}
      {showSettingsModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg p-6 w-full max-w-md mx-4">
            <h3 className="text-lg font-semibold mb-4">
              {editingItem ? 'Edit' : 'Add'} {modalType?.charAt(0).toUpperCase() + modalType?.slice(1)}
            </h3>
            
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium mb-2">Name</label>
                <input
                  type="text"
                  value={modalData.name || ''}
                  onChange={(e) => setModalData({ ...modalData, name: e.target.value })}
                  className="w-full border rounded-lg px-3 py-2"
                  placeholder={`Enter ${modalType} name`}
                />
              </div>
              
              <div>
                <label className="block text-sm font-medium mb-2">Description</label>
                <textarea
                  value={modalData.description || ''}
                  onChange={(e) => setModalData({ ...modalData, description: e.target.value })}
                  className="w-full border rounded-lg px-3 py-2 h-24"
                  placeholder={`Enter ${modalType} description`}
                />
              </div>
              
              <div className="flex items-center">
                <input
                  type="checkbox"
                  checked={modalData.isActive !== false}
                  onChange={(e) => setModalData({ ...modalData, isActive: e.target.checked })}
                  className="mr-2"
                />
                <label className="text-sm font-medium">Active</label>
              </div>
            </div>
            
            <div className="flex justify-end space-x-3 mt-6">
              <button
                onClick={() => {
                  setShowSettingsModal(false);
                  setEditingItem(null);
                  setModalData({});
                }}
                className="px-4 py-2 text-gray-600 border rounded-lg hover:bg-gray-50"
                disabled={loading}
              >
                Cancel
              </button>
              <button
                onClick={handleModalSave}
                disabled={loading || !modalData.name}
                className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50"
              >
                {loading ? 'Saving...' : (editingItem ? 'Update' : 'Create')}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default TicketSettingsPage;
